    "peerDependencies": {
        "@goat-sdk/core": "workspace:*",
        "viem": "catalog:"
    },
    "keywords": ["ai", "agents", "web3", "kyberswap", "defi", "dex", "swap", "aggregator", "evm"],
    "license": "MIT",
    "homepage": "https://ohmygoat.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goat-sdk/goat.git"
